+// Keep a newline-delimited progress signal for the Android process bridge. The
+// persistent server otherwise reports generation progress through terminal
+// rendering that BufferedReader cannot consume reliably while a job is active.
+static void saient_progress_callback(int step, int steps, float, void*) {
+    fprintf(stderr, "SAIENT_WAN_PROGRESS completed=%d total=%d\n", step, steps);
+    fflush(stderr);
+}
